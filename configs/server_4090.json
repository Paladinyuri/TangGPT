{
  "model": {
    "vocab_size": 4096,
    "max_seq_len": 256,
    "n_layers": 6,
    "d_model": 384,
    "n_heads": 6,
    "d_ff": 1024,
    "dropout": 0.0,
    "rope_base": 10000.0,
    "rms_norm_eps": 1e-5,
    "tie_embeddings": true
  },
  "training": {
    "batch_size": 64,
    "gradient_accumulation_steps": 2,
    "max_steps": 8000,
    "learning_rate": 0.0003,
    "min_learning_rate": 0.00003,
    "warmup_steps": 400,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "precision": "auto",
    "num_workers": 4,
    "log_interval": 10,
    "eval_interval": 500,
    "eval_batches": 50,
    "save_interval": 1000,
    "sample_interval": 500,
    "seed": 42
  }
}
